# Copy to .env.local (or set in your host) before enabling tracking / form endpoints.
# Leave blank to keep the site running without third-party scripts.

# Google Tag Manager (preferred for Ads conversion management)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account ID (AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Optional conversion label used with gtag send_to
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Form backend for lead qualification (e.g. Formspree / Web3Forms endpoint)
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional access key for providers that require it (e.g. Web3Forms)
NEXT_PUBLIC_FORM_ACCESS_KEY=
