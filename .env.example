# Public environment variables for KruskalCode.
# Copy to .env.local and fill in real IDs before Google Ads launch.
# Never invent Google Ads conversion IDs — copy them from Google Ads → Goals → Conversions.

# Optional: Google Tag Manager (preferred if you already use GTM)
NEXT_PUBLIC_GTM_ID=

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account ID, e.g. AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion action labels from Google Ads tag setup (the part after AW-XXXXXXX/)
# Fired only after a successful project inquiry / contact form submission
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Optional: separate label for the contact-page form (falls back to LEAD_LABEL)
NEXT_PUBLIC_GOOGLE_ADS_CONTACT_LABEL=

# Calendar / consultation click (https://cal.com/kruskalcode)
NEXT_PUBLIC_GOOGLE_ADS_CONSULT_LABEL=

# Phone number click
NEXT_PUBLIC_GOOGLE_ADS_PHONE_LABEL=

# Email click
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_LABEL=

# WhatsApp click (engagement only — do not use as a lead conversion)
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Form delivery (Web3Forms, Formspree, or similar JSON endpoint)
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
